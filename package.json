{
  "name": "clevervncclient",
  "version": "1.3.24",
  "description": "Run your screen monitor as remote devices or casting to video wall with CLEVER",
  "main": "index.js",
  "license": "ISC",
  "scripts": {
    "start": "electron .",
    "win32": "electron-builder --win --ia32",
    "win64": "electron-builder --win --x64"
  },
  "homepage": "www.closed-loop.biz",
  "author": {
    "name": "Closed-Loop Technology Pte. Ltd",
    "email": "sales@closed-loop.biz"
  },
  "dependencies": {
    "@wuild/electron-notification": "^1.0.3",
    "custom-electron-titlebar": "^3.2.5",
    "date-and-time": "^0.8.1",
    "electron-log": "^3.0.6",
    "is-reachable": "^5.0.0",
    "network-list": "^1.1.5",
    "node-websockify": "^1.0.3",
    "path": "^0.12.7",
    "portscanner": "^2.2.0"
  },
  "devDependencies": {
    "electron": "^10.0.0"
  },
  "build": {
    "appId": "vnc.client.app",
    "productName": "CLEVER.Screencast.VNC",
    "directories": {
      "output": "build"
    },
    "compression": "maximum",
    "win": {
      "target": "nsis",
      "icon": "./build/clt.png"
    },
    "linux": {
      "target": "deb",
      "icon": "./build/clt.png",
      "category": "AudioVideo",
      "desktop": "cltsvncapp"
    }
  }
}
