{
  "name": "clevervncclient",
  "version": "2.1.0",
  "description": "CLEVER VNC Client for screen sharing and remote access",
  "main": "index.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "author": "Closed-loop Technology Pte Ltd",
  "license": "ISC",
  "dependencies": {
    "async": "^3.2.5",
    "auto-launch": "^5.0.6",
    "cors": "^2.8.5",
    "electron-log": "^5.1.2",
    "express": "^4.19.1",
    "is-reachable": "^5.2.1",
    "moment": "^2.30.1",
    "systeminformation": "^5.22.6",
    "ws": "^8.15.1"
  },
  "devDependencies": {
    "electron": "^22.3.25",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.closed-loop.clevervncclient",
    "productName": "CLEVER VNC Client",
    "win": {
      "target": "nsis",
      "icon": "src/assets/media/logo.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "src/assets/media/logo.icns"
    },
    "linux": {
      "target": "AppImage",
      "icon": "src/assets/media/logo.png"
    }
  }
}