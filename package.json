{
  "name": "clevervncclient",
  "version": "2.1.0",
  "description": "Run your screen monitor as remote devices or casting to video wall with CLEVER",
  "main": "index.js",
  "license": "ISC",
  "scripts": {
    "start": "electron .",
    "win32": "electron-builder --win --ia32",
    "win64": "electron-builder --win --x64",
    "ubuntu32": "electron-builder --linux --ia32",
    "ubuntu64": "electron-builder --linux --x64"
  },
  "homepage": "www.closed-loop.biz",
  "author": {
    "name": "Closed-Loop Technology Pte. Ltd",
    "email": "sales@closed-loop.biz"
  },
  "dependencies": {
    "async": "^3.2.4",
    "auto-launch": "^5.0.5",
    "custom-electron-titlebar": "^4.1.6",
    "date-and-time": "^3.0.0",
    "electron-log": "^5.0.0",
    "electron-updater": "^6.1.1",
    "express": "^4.18.2",
    "is-port-reachable": "^4.0.0",
    "is-reachable": "^5.2.1",
    "moment": "^2.29.4",
    "path": "^0.12.7",
    "socket.io": "^4.7.2",
    "systeminformation": "^5.18.6",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "electron": "^22.3.25",
    "electron-builder": "^24.6.3"
  },
  "build": {
    "appId": "screencast.client.app",
    "productName": "CLEVER_Screencast",
    "copyright": "Copyright © 2000-2025, Closed-loop. All rights ® reserved",
    "directories": {
      "output": "build"
    },
    "compression": "maximum",
    "win": {
      "target": "nsis",
      "icon": "./build/clt.png"
    },
    "linux": {
      "target": "deb",
      "icon": "./build/clt.png",
      "category": "AudioVideo",
      "desktop": "cltsvncapp"
    }
  }
}

