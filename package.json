{
  "name": "clevervncclient",
  "version": "2.0.2",
  "description": "Run your screen monitor as remote devices or casting to video wall with CLEVER",
  "main": "index.js",
  "license": "ISC",
  "scripts": {
    "start": "electron .",
    "win32": "electron-builder --win --ia32",
    "win64": "electron-builder --win --x64",
    "ubuntu32": "electron-builder --linux --ia32",
    "ubuntu64": "electron-builder --linux --x64"
  },
  "homepage": "www.closed-loop.biz",
  "author": {
    "name": "Closed-Loop Technology Pte. Ltd",
    "email": "sales@closed-loop.biz"
  },
  "dependencies": {
    "@sukkis/node-multi-websockify": "^1.0.4",
    "@wuild/electron-notification": "^1.0.3",
    "async": "^3.2.4",
    "audify": "^1.7.1",
    "auto-launch": "^5.0.5",
    "custom-electron-titlebar": "^3.2.5",
    "date-and-time": "^0.8.1",
    "electron-log": "^3.0.6",
    "electron-updater": "^4.3.9",
    "express": "^4.18.2",
    "is-port-reachable": "^4.0.0",
    "is-reachable": "^5.0.0",
    "moment": "^2.29.4",
    "node-websockify": "^1.0.3",
    "path": "^0.12.7"
  },
  "devDependencies": {
    "electron": "^10.0.0",
    "electron-builder": "^22.3.3"
  },
  "build": {
    "appId": "screencast.client.app",
    "productName": "CLEVER_Screencast",
    "copyright": "Copyright © 2000-2022, Closed-loop. All rights ® reserved",
    "directories": {
      "output": "build"
    },
    "compression": "maximum",
    "win": {
      "target": "nsis",
      "icon": "./build/clt.png"
    },
    "linux": {
      "target": "deb",
      "icon": "./build/clt.png",
      "category": "AudioVideo",
      "desktop": "cltsvncapp"
    }
  }
}
