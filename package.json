{
  "name": "cleverscreencast",
  "version": "2.2.0",
  "description": "CLEVER Screencast KVM for screen sharing and remote access",
  "main": "index.js",
  "scripts": {
    "start": "electron .",
    "test": "node test/updateStatus.spec.js",
    "build": "electron-builder --publish never",
    "release": "electron-builder --publish always",
    "win64": "electron-builder --win --x64 --publish never",
    "mac": "electron-builder --mac --x64 --arm64 --publish never",
    "linux": "electron-builder --linux --x64 --publish never"
  },
  "homepage": "https://www.closed-loop.biz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/clt-sg/clt-clever-screencastapp.git"
  },
  "bugs": {
    "url": "https://github.com/clt-sg/clt-clever-screencastapp/issues"
  },
  "author": {
    "name": "Closed-Loop Technology Pte. Ltd",
    "email": "sales@closed-loop.biz"
  },
  "license": "ISC",
  "dependencies": {
    "async": "^3.2.5",
    "auto-launch": "^5.0.6",
    "cors": "^2.8.5",
    "electron-log": "^5.1.2",
    "electron-updater": "^6.8.9",
    "express": "^4.19.1",
    "is-reachable": "^5.2.1",
    "moment": "^2.30.1",
    "systeminformation": "^5.22.6",
    "ws": "^8.15.1"
  },
  "devDependencies": {
    "electron": "^22.3.25",
    "electron-builder": "^24.6.3"
  },
  "build": {
    "appId": "screencast.client.app",
    "productName": "CLEVER_Screencast",
    "copyright": "Copyright © 2000-2026, Closed-loop. All rights ® reserved",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "build/Release",
      "buildResources": "src/assets/media"
    },
    "files": [
      "**/*",
      "!src/assets/js/adapter_source/test/**",
      "!src/assets/js/adapter_source/src/**",
      "!docs/**",
      "!test/**",
      "!.github/**"
    ],
    "compression": "maximum",
    "publish": {
      "provider": "github",
      "owner": "clt-sg",
      "repo": "clt-clever-screencastapp",
      "releaseType": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "src/assets/media/logo.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "src/assets/media/logo.png",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "src/assets/media/logo.png",
      "category": "AudioVideo"
    }
  }
}
