{
  "name": "cleverscreencast",
  "version": "2.1.0",
  "description": "CLEVER Screencast KVM for screen sharing and remote access",
  "main": "index.js",
  "scripts": {
    "start": "electron .",
    "win32": "electron-builder --win --ia32",
    "win64": "electron-builder --win --x64",
    "ubuntu32": "electron-builder --linux --ia32",
    "ubuntu64": "electron-builder --linux --x64"
  },
  "homepage": "www.closed-loop.biz",
  "author": {
    "name": "Closed-Loop Technology Pte. Ltd",
    "email": "sales@closed-loop.biz"
  },
  "license": "ISC",
  "dependencies": {
    "async": "^3.2.5",
    "auto-launch": "^5.0.6",
    "cors": "^2.8.5",
    "electron-log": "^5.1.2",
    "express": "^4.19.1",
    "is-reachable": "^5.2.1",
    "moment": "^2.30.1",
    "systeminformation": "^5.22.6",
    "ws": "^8.15.1"
  },
  "devDependencies": {
    "electron": "^22.3.25",
    "electron-builder": "^24.6.3"
  },
  "build": {
    "appId": "screencast.client.app",
    "productName": "CLEVER_Screencast",
    "copyright": "Copyright © 2000-2025, Closed-loop. All rights ® reserved",
    "directories": {
      "output": "build/Release"
    },
    "compression": "maximum",
    "win": {
      "target": "nsis",
      "icon": "build/icons/clt.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icons/clt.icns"
    },
    "linux": {
      "target": "deb",
      "icon": "build/icons/clt.png",
      "category": "AudioVideo",
      "desktop": "cltsvncapp"
    }
  }
}